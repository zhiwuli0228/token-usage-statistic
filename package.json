{
  "name": "token-usage-statistic",
  "version": "0.2.0",
  "private": true,
  "description": "Token usage statistics for every model call in DeepSeek Harness: samples provider usage, backfills history, prices each call when it happened, and renders a sidebar panel in the Web and Desktop UI.",
  "license": "MIT",
  "author": "zhiwuli0228",
  "homepage": "https://github.com/zhiwuli0228/token-usage-statistic#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhiwuli0228/token-usage-statistic.git"
  },
  "bugs": {
    "url": "https://github.com/zhiwuli0228/token-usage-statistic/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:bundle": "node scripts/smoke-client.mjs",
    "check": "npm run typecheck && npm run build && npm run test && npm run test:bundle"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "token-usage",
    "statistics",
    "cost"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
